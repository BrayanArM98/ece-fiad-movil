# La app usa la API publicada en Azure (.env.development y .env.production).
# Para cambiarla en tu computadora, copia este archivo como .env.local; .env.local no se sube al repositorio.

# API local en tu red (ver specs/03-api.md):
# EXPO_PUBLIC_API_URL=http://192.168.1.70:5200

# Modo demostración con datos de ejemplo, sin servidor:
# EXPO_PUBLIC_API_URL=
